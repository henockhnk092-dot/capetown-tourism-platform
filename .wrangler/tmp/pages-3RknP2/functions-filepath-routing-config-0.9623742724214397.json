{
  "routes": [
    {
      "routePath": "/api/gemini/:path*",
      "mountPath": "/api/gemini",
      "method": "POST",
      "module": [
        "api/gemini/[[path]].js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/booking-email",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/booking-email.js:onRequestPost"
      ]
    },
    {
      "routePath": "/api/tts",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/tts.js:onRequestPost"
      ]
    }
  ],
  "baseURL": "/"
}